{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resultado de módulo académico",
  "type": "object",
  "required": ["modulo", "grupo", "estudiante", "target", "timestamp", "status", "data", "error_message"],
  "properties": {
    "modulo": {"type": "string", "minLength": 1},
    "grupo": {"type": "integer", "minimum": 0, "maximum": 4},
    "estudiante": {"type": "string", "minLength": 1},
    "target": {"type": "string"},
    "timestamp": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "error"]},
    "data": {"type": "object"},
    "error_message": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"status": {"const": "success"}}},
     "then": {"properties": {"error_message": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "error"}}},
     "then": {"properties": {"error_message": {"type": "string"}}}}
  ]
}
